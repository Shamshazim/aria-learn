<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Minimum entitlements for a hardened, notarized build.

  The app supervises three child processes it ships itself (the JVM, PostgreSQL and Ollama).
  Under the hardened runtime that needs JIT and unsigned-memory permissions, because the JVM
  and the model runner both generate code at runtime. Network access is client-side only —
  everything the app talks to is on 127.0.0.1, except the one-time model download.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
</dict>
</plist>
