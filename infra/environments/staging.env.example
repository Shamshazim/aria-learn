# Staging environment
#
# Names only. **No values, ever** — every one of these lives in the platform secrets manager
# for this environment (`fly secrets set` for the API and the voice worker, a Supabase project
# setting for the database, a build argument for the web bundle). A value committed here is a
# value in the registry, in the CI log and in every image layer built afterwards.
#
# `npm run check:env` holds this file to `.env.example`: a variable in one and not the other
# fails CI (X-01).
#
# Staging holds no production data and no production keys. It is what every release is proved
# against, including the rollback drill, so it is shaped exactly like production apart from
# size (see `infra/README.md`).

# ── Runtime ──
NODE_ENV=
API_PORT=
WEB_PORT=
LOG_LEVEL=
CORS_ORIGINS=
JSON_BODY_LIMIT=
SHUTDOWN_TIMEOUT_MS=

# ── Database — Supabase Postgres, per environment ──
DATABASE_URL=
DB_POOL_MAX=
DB_IDLE_TIMEOUT_MS=
DB_CONNECTION_TIMEOUT_MS=
DB_STATEMENT_TIMEOUT_MS=

# ── Model spend and operator access ──
AI_DAILY_SPEND_CAP_USD=
STATUS_OPERATOR_TOKEN=

# ── Tutoring policy ──
SESSION_LIMIT_EARLY_MINUTES=
SESSION_LIMIT_MIDDLE_MINUTES=
SESSION_LIMIT_SENIOR_MINUTES=
MEMORY_REPETITIONS_FOR_DURABLE_FACT=

# ── Development-only ──
ARIA_DEMO_STUDENT_ID=
ALLOW_DEMO_STUDENT=

# ── Adult identity (Supabase Auth) and child sessions ──
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=
SUPABASE_SERVICE_ROLE_KEY=
CHILD_SESSION_SECRET=

# ── Safeguarding ──
SAFEGUARDING_WEBHOOK_URL=
SAFEGUARDING_WEBHOOK_TOKEN=

# ── Web build ──
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Voice runtime — LiveKit and the voice worker ──
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
ARIA_API_URL=
VOICE_WORKER_TOKEN=
VOICE_REGION=
VOICE_PRIVACY_SIGNOFF_ID=
VOICE_STT_MODEL=
VOICE_TTS_MODEL=
VOICE_TTS_VOICE_EARLY=
VOICE_TTS_VOICE_MIDDLE=
VOICE_TTS_VOICE_SENIOR=

# ── Model providers ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# ── Set by the platform, not by an operator ──────────────────
PORT=
FLY_APP_NAME=
FLY_REGION=
PRIMARY_REGION=

