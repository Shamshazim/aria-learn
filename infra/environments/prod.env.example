# Production environment
#
# Names only. **No values, ever** — every one of these lives in the platform secrets manager
# for this environment (`fly secrets set` for the API and the voice worker, a Supabase project
# setting for the database, a build argument for the web bundle). A value committed here is a
# value in the registry, in the CI log and in every image layer built afterwards.
#
# `npm run check:env` holds this file to `.env.example`: a variable in one and not the other
# fails CI (X-01).
#
# Production. `ARIA_DEMO_STUDENT_ID` is refused by the API here and the deploy workflow fails
# before an instance starts if it is set at all. `STATUS_OPERATOR_TOKEN`,
# `SAFEGUARDING_WEBHOOK_URL` and `SAFEGUARDING_WEBHOOK_TOKEN` are required — boot refuses
# without them.

# ── Runtime ──
NODE_ENV=
API_PORT=
WEB_PORT=
LOG_LEVEL=
CORS_ORIGINS=
JSON_BODY_LIMIT=
SHUTDOWN_TIMEOUT_MS=

# ── Database — Supabase Postgres, per environment ──
DATABASE_URL=
DB_POOL_MAX=
DB_IDLE_TIMEOUT_MS=
DB_CONNECTION_TIMEOUT_MS=
DB_STATEMENT_TIMEOUT_MS=

# ── Model spend and operator access ──
AI_DAILY_SPEND_CAP_USD=
STATUS_OPERATOR_TOKEN=

# ── Tutoring policy ──
SESSION_LIMIT_EARLY_MINUTES=
SESSION_LIMIT_MIDDLE_MINUTES=
SESSION_LIMIT_SENIOR_MINUTES=
MEMORY_REPETITIONS_FOR_DURABLE_FACT=

# ── Development-only ──
ARIA_DEMO_STUDENT_ID=

# ── Safeguarding ──
SAFEGUARDING_WEBHOOK_URL=
SAFEGUARDING_WEBHOOK_TOKEN=

# ── Web build ──
VITE_API_BASE_URL=

# ── Model providers ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# ── Set by the platform, not by an operator ──────────────────
PORT=
FLY_APP_NAME=
FLY_REGION=
PRIMARY_REGION=

