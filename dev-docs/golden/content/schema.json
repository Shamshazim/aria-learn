{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aria content golden item group",
  "type": "array",
  "minItems": 1,
  "maxItems": 100,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "subject",
      "skillCode",
      "band",
      "promptName",
      "input",
      "expectation",
      "humanReview"
    ],
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "subject": { "enum": ["arithmetic", "reading", "writing"] },
      "skillCode": { "type": "string", "minLength": 1 },
      "band": { "enum": ["early", "middle", "senior"] },
      "promptName": { "const": "practice-item" },
      "input": {
        "type": "object",
        "required": ["skill", "difficulty"],
        "properties": {
          "skill": { "type": "string", "minLength": 1 },
          "difficulty": { "enum": ["easier", "same", "harder"] }
        },
        "additionalProperties": false
      },
      "expectation": { "type": "object" },
      "humanReview": {
        "type": "object",
        "required": ["status", "notes"],
        "properties": {
          "status": { "enum": ["pending", "approved"] },
          "notes": { "type": "string", "minLength": 1 },
          "reviewer": { "type": "string", "minLength": 1 },
          "reviewedAt": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    }
  }
}
