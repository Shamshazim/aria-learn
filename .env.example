# Copy to .env and fill in. `.env` is gitignored and must never be committed
# (CODE-STANDARDS §8). Every key the workspace reads is listed here with a dummy value.

# ── Runtime ──────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3000
WEB_PORT=5173

# ── Database (PostgreSQL only) ───────────────────────────────
# Required. The API refuses to start without it, and refuses a non-postgres URL.
# The database tests create and drop a throwaway database per test file, so this role
# needs CREATEDB.
DATABASE_URL=postgresql://aria:aria@localhost:5432/aria_dev

# Pool sizing and timeouts. Defaults suit a single process; raise DB_POOL_MAX only against
# Postgres's own connection ceiling, never past it.
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
# Enforced by Postgres, so a runaway query dies even if the request that started it is gone.
DB_STATEMENT_TIMEOUT_MS=10000

# Daily model spend allowed per child before verified cache-only mode takes over.
AI_DAILY_SPEND_CAP_USD=1.00
# Required in production. Keep this server-side; it protects /api/v1/status.
STATUS_OPERATOR_TOKEN=

# ── Model providers (hosted only — no local weights) ─────────
# Adding a vendor is configuration, not code (CODE-STANDARDS §4). Keys are read at boot;
# routed providers must be filled in, while unused providers may stay blank.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
