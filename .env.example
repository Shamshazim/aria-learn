# Copy to .env and fill in. `.env` is gitignored and must never be committed
# (CODE-STANDARDS §8). Every key the workspace reads is listed here with a dummy value.

# ── Runtime ──────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3000
WEB_PORT=5173

# ── Database (PostgreSQL only) ───────────────────────────────
# Required. The API refuses to start without it, and refuses a non-postgres URL.
# The database tests create and drop a throwaway database per test file, so this role
# needs CREATEDB.
DATABASE_URL=postgresql://aria:aria@localhost:5432/aria_dev

# Pool sizing and timeouts. Defaults suit a single process; raise DB_POOL_MAX only against
# Postgres's own connection ceiling, never past it.
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
# Enforced by Postgres, so a runaway query dies even if the request that started it is gone.
DB_STATEMENT_TIMEOUT_MS=10000

# Daily model spend allowed per child before verified cache-only mode takes over.
AI_DAILY_SPEND_CAP_USD=1.00
# Required in production. Keep this server-side; it protects /api/v1/status.
STATUS_OPERATOR_TOKEN=

# Phase 1 tutoring policy (bounded by the age-band ranges in the product plan).
SESSION_LIMIT_EARLY_MINUTES=12
SESSION_LIMIT_MIDDLE_MINUTES=20
SESSION_LIMIT_SENIOR_MINUTES=30
MEMORY_REPETITIONS_FOR_DURABLE_FACT=1
# Development only, and it takes both of these. Must reference an existing student row;
# forbidden in production, where boot refuses to start if either is set (P2H-12).
ARIA_DEMO_STUDENT_ID=
ALLOW_DEMO_STUDENT=false

# --- Identity (P2H-12) -------------------------------------------------------------------
# The Supabase project parents sign in to. Required in production; without it nobody can sign
# in at all and every student route refuses, which is the correct behaviour for a deployment
# that has not been given one.
SUPABASE_URL=
# The `aud` claim Supabase mints. Change only if the project is configured differently.
SUPABASE_JWT_AUDIENCE=authenticated
# Signs the child session cookie. At least 32 characters, and not shared with anything else.
CHILD_SESSION_SECRET=
# Required in production. Receives category and internal ids, never disclosure text.
SAFEGUARDING_WEBHOOK_URL=
SAFEGUARDING_WEBHOOK_TOKEN=

# Web production API origin. Leave empty in development to use the Vite /api proxy.
VITE_API_BASE_URL=
# P2H-12: the same Supabase project as SUPABASE_URL, and its public anon key. Both are meant
# to ship in the bundle — the anon key is not a secret — and without them the sign-in screen
# says so rather than failing on the button.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Model providers (hosted only — no local weights) ─────────
# Adding a vendor is configuration, not code (CODE-STANDARDS §4). Keys are read at boot;
# routed providers must be filled in, while unused providers may stay blank.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# ── Phase 2 realtime voice ───────────────────────────────────
# Supplying any of these enables the voice runtime and requires the complete group.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
ARIA_API_URL=http://localhost:3000
VOICE_WORKER_TOKEN=
VOICE_REGION=us-west
# Required when voice is enabled in production. This identifies the signed privacy review;
# it is not a placeholder approval and must not be invented.
VOICE_PRIVACY_SIGNOFF_ID=
# Integration candidates only. The human-labelled voice golden set selects providers.
VOICE_STT_MODEL=assemblyai/universal-3-5-pro
VOICE_TTS_MODEL=fishaudio/s2.1-pro
# P2H-08: a named voice per band — no default. The voice worker refuses to boot without all
# three. Candidates and the listening review that chose them: dev-docs/voice-review.md
VOICE_TTS_VOICE_EARLY=
VOICE_TTS_VOICE_MIDDLE=
VOICE_TTS_VOICE_SENIOR=
