# Config for the e2e explorer agent. Override any of these inline, e.g.:
#   BASE_URL=http://localhost:5173 ./run-explorer.sh
#
# These are LOCAL DEV demo credentials only — never commit real secrets here.

# Where the app is served (the Vite proxy path a human actually uses).
BASE_URL="http://localhost:5173"

# Seeded demo parent account (from backend DataInitializer.java).
PARENT_LOGIN="parent@demo.com"
PARENT_PASSWORD="parent123"

# A throwaway student the agent may create + log in as, to exercise the
# learning flow. If a student with this username already exists, the agent
# will just try to reuse it.
STUDENT_USERNAME="qa_test_student"
STUDENT_PASSWORD="TestPass123"
