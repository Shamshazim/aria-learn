{
  "name": "@aria/api",
  "version": "0.0.0",
  "private": true,
  "description": "Aria Learn API \u2014 Node + Express + TypeScript.",
  "type": "module",
  "scripts": {
    "bench:arrival": "tsx src/scripts/bench-arrival.ts",
    "bench:turn": "tsx src/scripts/bench-turn.ts",
    "cost:report": "tsx src/scripts/cost-report.ts",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "dev": "tsx watch src/index.ts",
    "golden:content": "tsx src/testing/golden/run-cli.ts",
    "golden:tutoring": "tsx src/testing/tutoring/run-cli.ts",
    "identity:replay-deletions": "tsx src/scripts/replay-deletions.ts",
    "report:phase1": "tsx src/scripts/phase1-report.ts",
    "start": "tsx src/index.ts",
    "test": "cd ../.. && vitest run --project api",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aria/shared": "*",
    "@aria/tutor": "*",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12"
  }
}
